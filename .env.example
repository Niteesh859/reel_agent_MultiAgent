# ── Project repository ──────────────────────────────────────────────────
GITHUB_REPO_URL=https://github.com/Niteesh859/reel_agent_MultiAgent.git

# ── LLM (OpenRouter, OpenAI-compatible API) ─────────────────────────────
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Researcher web search (Tavily — free tier: 1,000 credits/month) ─────
# https://app.tavily.com
TAVILY_API_KEY=

# ── Checkpoint channel: Telegram (OPTIONAL) ─────────────────────────────
# Leave both empty to run TUI-only. Create a bot with @BotFather to get the
# token; TELEGRAM_CHAT_ID is your own chat's numeric id (message the bot,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to read it).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Observability: LangSmith tracing (OPTIONAL) ─────────────────────────
# Set LANGSMITH_TRACING=true to send every pipeline run (researcher call,
# each strategist/writer loop round, token usage) to LangSmith.
# https://smith.langchain.com  → Settings → API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reels-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
